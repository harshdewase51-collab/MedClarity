# Environment Configuration for Medical Report Simplifier Backend
PROJECT_NAME="Medical Report Simplifier"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Server Settings
HOST="0.0.0.0"
PORT=8000

# File Upload Settings
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg", "txt"]

# Database Settings (SQLite by default)
DATABASE_URL="sqlite:///./medical_reports.db"

# AI / LLM Configuration
# Options: "hybrid", "gemini", "openai", "rule_based"
AI_PROVIDER="hybrid"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
AI_TEMPERATURE=0.2

# Medical Safety Settings
ENFORCE_SAFETY_DISCLAIMER=True
AUTO_CLEANUP_TEMP_FILES=False
